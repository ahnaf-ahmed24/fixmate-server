# ── Server ──────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── Database ────────────────────────────────────────────
# Local MongoDB (mongod), or `npm run dev:db` (in-memory), or a MongoDB Atlas URI
MONGODB_URI=mongodb://127.0.0.1:27017
DB_NAME=fixmate

# ── BetterAuth (user management + JWT signing) ──────────
# Generate a strong secret:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=replace-me-with-a-long-random-string
# Must match the running server URL exactly (used for trusted origins & JWKS)
BETTER_AUTH_URL=http://localhost:5000
JWT_ISSUER=fixmate-server
JWT_AUDIENCE=fixmate-client
JWT_EXPIRES_IN=7d

# ── CORS / trusted origins (comma separated) ────────────
CLIENT_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Stripe (test mode keys) ─────────────────────────────
STRIPE_SECRET_KEY=
# Webhook endpoint: POST {BETTER_AUTH_URL}/api/payments/webhook → signing secret (whsec_...)
STRIPE_WEBHOOK_SECRET=

# ── ImgBB (service & profile image uploads) ─────────────
IMGBB_API_KEY=

# ── Social login (optional, omitted when empty) ─────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
