# ── Server ──────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── Database ────────────────────────────────────────────
# Local MongoDB, or scripts/dev-db.js (in-memory), or MongoDB Atlas URI
DATABASE_URL=mongodb://127.0.0.1:27017
DB_NAME=fixmate

# ── Auth (JWT) ──────────────────────────────────────────
# Generate a strong secret:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string
JWT_EXPIRES_IN=7d
COOKIE_NAME=fixmate_token

# ── CORS (comma separated list, or * to allow all) ──────
CLIENT_URL=http://localhost:5173

# ── Stripe (test mode keys) ─────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd

# ── Seeded super admin (npm run seed) ───────────────────
SUPER_ADMIN_NAME=FixMate Admin
SUPER_ADMIN_EMAIL=admin@fixmate.com
SUPER_ADMIN_PASSWORD=Admin@1234
